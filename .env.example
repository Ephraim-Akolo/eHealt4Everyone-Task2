# Copy this to .env (or export these as real environment variables /
# a docker-compose .env file) before running in anything other than
# throwaway local dev. Never commit a real .env.

# Django
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=false
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=

# CORS
CORS_ORIGIN_ALLOW_ALL=false
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Postgres (used to build DATABASE_URL in docker-compose.yml)
DB_NAME=taskdb
DB_USER=taskuser
DB_PASSWORD=change-me

# Redis
REDIS_PASSWORD=change-me

# Logging
LOG_LEVEL=INFO
