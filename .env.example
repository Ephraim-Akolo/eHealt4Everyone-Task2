# ---------------------------------------------------------------------------
# .env.example
# Copy to .env and adjust as needed. All variables below have working
# defaults baked into docker-compose.yml, so the stack runs fine without
# a .env file at all — this file is only for overriding those defaults.
# ---------------------------------------------------------------------------

# Django
SECRET_KEY=dev-only-insecure-key
DEBUG=true
ALLOWED_HOSTS=*

# PostgreSQL
DB_NAME=taskdb
DB_USER=taskuser
DB_PASSWORD=taskpass

# Redis
REDIS_PASSWORD=devredispass

